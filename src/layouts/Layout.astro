---
import '../styles/global.css';
import { personal } from '../data/portfolio';
import { ACCENTS, theme, GROUND } from '../data/theme.js';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Founding engineer at Mando building AI-powered enterprise products — natural language search, ticketing, video calls, booking and Stripe billing. Previously cut trading-system latency by 20% at Quantitative Brokers. Full stack: Next.js, FastAPI, PostgreSQL, Terraform. IIT Madras.",
  ogImage = '/og-image.png',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/* Follows `site` in astro.config.mjs — one place to change the domain. */
const siteUrl = Astro.site ? Astro.site.origin : 'https://rishikeshs.dev';
const canonicalUrl = `${siteUrl}${base}`;
/* the blog lives on its own subdomain of the same domain */
const blogUrl = Astro.site ? `${Astro.site.protocol}//blog.${Astro.site.host}/` : 'https://blog.rishikeshs.dev/';
const ogImageUrl = `${siteUrl}${base}${ogImage}`;
const resumeUrl = `${base}/${personal.resumeFile}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: personal.name,
  jobTitle: personal.role,
  email: `mailto:${personal.email}`,
  url: canonicalUrl,
  worksFor: { '@type': 'Organization', name: 'Mando' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology, Madras' },
  address: { '@type': 'PostalAddress', addressLocality: 'Chennai', addressCountry: 'IN' },
  sameAs: [personal.social.github, personal.social.linkedin].filter(Boolean),
  knowsAbout: ['Software Engineering', 'Next.js', 'FastAPI', 'PostgreSQL', 'Terraform', 'Large Language Models'],
};
/* Theme mode. Anything but 'auto' pins one side: the attribute is stamped in the
 * markup, the pre-paint script has nothing to resolve, and the toggle is gone. */
const locked = theme.mode === 'light' || theme.mode === 'dark' ? theme.mode : null;

/* The active accent palette as CSS — only the one the site is set to ships. */
const a = ACCENTS[theme.accent] ?? ACCENTS.signal;
const accentCss =
  `:root[data-accent="${theme.accent}"]{` +
  `--a-l:${a.light.base};--a-l-2:${a.light.deep};--a-l-on:${a.light.on};` +
  `--a-d:${a.dark.base};--a-d-2:${a.dark.deep};--a-d-on:${a.dark.on};}`;
---

<!doctype html>
<html
  lang="en"
  data-accent={theme.accent}
  data-theme={locked ?? undefined}
  data-theme-lock={locked ? '' : undefined}
>
  <head>
    <style is:inline set:html={accentCss}></style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Rishikesh S" />
    <meta name="keywords" content="Rishikesh S, Software Engineer, Founding Engineer, Mando, Full Stack Developer, Next.js, FastAPI, Python, Go, Terraform, IIT Madras, Portfolio" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    {
      locked ? (
        <meta name="theme-color" content={GROUND[locked]} />
      ) : (
        <>
          <meta name="theme-color" content={GROUND.light} media="(prefers-color-scheme: light)" />
          <meta name="theme-color" content={GROUND.dark} media="(prefers-color-scheme: dark)" />
        </>
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Rishikesh S — Portfolio" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <noscript>
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    </noscript>

    <!-- theme, resolved before first paint so the page never flashes.
         Skipped entirely when the site is pinned to one mode, since the
         attribute is already in the markup. -->
    <script is:inline>
      (function () {
        if (document.documentElement.hasAttribute('data-theme-lock')) return;
        try {
          var saved = localStorage.getItem('theme');
          var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', saved || system);
        } catch (e) {}
      })();
    </script>
  </head>

  <body id="top" data-resume={resumeUrl} data-home={`${base}/`} data-blog={blogUrl} data-ground-light={GROUND.light} data-ground-dark={GROUND.dark}>
    <a class="skip" href="#main">Skip to content</a>

    <slot />

    <!-- interactive terminal -->
    <div class="term-overlay" id="termOverlay" role="dialog" aria-modal="true" aria-label="Interactive terminal">
      <div class="term">
        <div class="term-bar">
          <button class="d r" id="termClose" title="Close terminal" aria-label="Close terminal"></button><span class="d y"></span><span class="d g"></span>
          <span class="t">rishikesh@portfolio — interactive · type 'help' · esc to close</span>
        </div>
        <div class="term-body" id="termBody">
          <div class="out">Welcome. Type <span class="k">help</span> for commands. <span class="cmt"># tab completes, ↑/↓ recalls history</span></div>
        </div>
        <div class="term-prompt">
          <span class="ps1">rishikesh@portfolio:~$</span>
          <input class="term-input" id="termInput" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="120" aria-label="Terminal input" />
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var resumeUrl = document.body.dataset.resume || '';

        /* ---------- scroll reveal ---------- */
        var reveals = document.querySelectorAll('.reveal');
        var pending = Array.prototype.slice.call(reveals);
        function revealAll() { reveals.forEach(function (el) { el.classList.add('in'); }); }
        /* The observer is the mechanism; this is the guarantee. Anything standing
           in the viewport is shown whatever the observer did or did not deliver —
           a backgrounded tab, a restored scroll position, a prerender. */
        function revealVisible() {
          for (var i = pending.length - 1; i >= 0; i--) {
            var el = pending[i];
            if (el.classList.contains('in')) { pending.splice(i, 1); continue; }
            var box = el.getBoundingClientRect();
            if (box.top < window.innerHeight && box.bottom > 0) {
              el.classList.add('in');
              pending.splice(i, 1);
            }
          }
        }
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
          reveals.forEach(function (el) { io.observe(el); });
          // Never let the animation be the reason content is invisible.
          setTimeout(revealVisible, 1200);
        } else {
          revealAll();
        }

        /* ---------- scroll progress + active section ---------- */
        var progress = document.getElementById('navProgress');
        var navLinks = Array.prototype.slice.call(document.querySelectorAll('[data-nav]'));
        var sections = navLinks
          .map(function (a) { return document.getElementById(a.dataset.nav); })
          .filter(Boolean);
        var ticking = false;

        function update() {
          ticking = false;
          if (tickTimer) { clearTimeout(tickTimer); tickTimer = 0; }
          revealVisible();

          var max = document.documentElement.scrollHeight - window.innerHeight;
          if (progress) progress.style.setProperty('--p', max > 0 ? Math.min(window.scrollY / max, 1) : 0);

          var current = null;
          for (var i = 0; i < sections.length; i++) {
            if (sections[i].getBoundingClientRect().top <= 140) current = sections[i].id;
          }
          navLinks.forEach(function (a) { a.classList.toggle('active', a.dataset.nav === current); });
        }

        var tickTimer = 0;
        function runTick() {
          if (tickTimer) { clearTimeout(tickTimer); tickTimer = 0; }
          update();
        }
        function onScroll() {
          /* Three delivery regimes, and the handler must survive all of them.
             Hidden: no frames, and timers are throttled to whole seconds or worse,
             so run straight away. Occluded but visible: frames stop while timers
             keep normal resolution, so the timer is the floor that stops a raised
             flag from latching this off for good. Normal: the frame wins the race
             and clears the timer. */
          if (document.hidden) { runTick(); return; }
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(runTick);
          tickTimer = setTimeout(runTick, 250);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        document.addEventListener('visibilitychange', function () { ticking = false; onScroll(); });
        onScroll();

        /* ---------- theme ---------- */
        var themeBtn = document.getElementById('themeBtn');
        var themeLocked = document.documentElement.hasAttribute('data-theme-lock');
        var GROUND = { light: document.body.dataset.groundLight, dark: document.body.dataset.groundDark };

        /* The two <meta name="theme-color"> tags in the head answer the OS query.
           Once the visitor toggles against the OS they stop being right, so a
           third, media-less tag is appended — last match wins — and kept in step. */
        var groundMeta = null;
        function paintBrowserChrome(next) {
          if (!GROUND[next]) return;
          if (!groundMeta) {
            groundMeta = document.createElement('meta');
            groundMeta.name = 'theme-color';
            document.head.appendChild(groundMeta);
          }
          groundMeta.setAttribute('content', GROUND[next]);
        }

        function setTheme(next) {
          if (themeLocked) return;
          document.documentElement.setAttribute('data-theme', next);
          paintBrowserChrome(next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        }
        function toggleTheme() {
          setTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        }
        if (themeBtn) themeBtn.addEventListener('click', toggleTheme);

        function storedTheme() { try { return localStorage.getItem('theme'); } catch (e) { return null; } }
        if (!themeLocked && storedTheme()) paintBrowserChrome(storedTheme());

        /* Nobody has chosen yet: keep following the OS while the tab stays open. */
        var osDark = window.matchMedia('(prefers-color-scheme: dark)');
        var onOsChange = function (e) {
          if (themeLocked || storedTheme()) return;
          document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        };
        if (osDark.addEventListener) osDark.addEventListener('change', onOsChange);
        else if (osDark.addListener) osDark.addListener(onOsChange);

        /* ---------- mobile drawer ---------- */
        var menuBtn = document.getElementById('menuBtn');
        var drawer = document.getElementById('drawer');
        function setDrawer(open) {
          if (!menuBtn || !drawer) return;
          drawer.classList.toggle('open', open);
          menuBtn.setAttribute('aria-expanded', String(open));
          menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          menuBtn.textContent = open ? '×' : '≡';
        }
        function drawerOpen() { return !!drawer && drawer.classList.contains('open'); }
        if (menuBtn && drawer) {
          menuBtn.addEventListener('click', function () { setDrawer(!drawerOpen()); });
          drawer.addEventListener('click', function (e) {
            if (e.target.tagName === 'A') setDrawer(false);
          });
          /* an open drawer must not survive a tap outside it, or a resize back to
             the width where the button that opened it no longer exists */
          document.addEventListener('click', function (e) {
            if (!drawerOpen()) return;
            if (drawer.contains(e.target) || menuBtn.contains(e.target)) return;
            setDrawer(false);
          });
          window.addEventListener('resize', function () {
            if (drawerOpen() && window.innerWidth > 760) setDrawer(false);
          }, { passive: true });
        }

        /* ---------- copy buttons ---------- */
        /* One shared live region for the buttons that have no text of their own
           to change. Created once rather than per button, so a screen reader
           hears one announcement instead of a dozen silent landmarks. */
        var announcer = null;
        function say(message) {
          if (!announcer) {
            announcer = document.createElement('div');
            announcer.setAttribute('role', 'status');
            announcer.setAttribute('aria-live', 'polite');
            announcer.style.cssText = 'position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;';
            document.body.appendChild(announcer);
          }
          announcer.textContent = '';
          setTimeout(function () { announcer.textContent = message; }, 30);
        }

        document.querySelectorAll('.copy-target').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var value = btn.dataset.copy || '';
            var label = btn.querySelector('.txt');
            var original = label ? label.textContent : '';
            var originalTitle = btn.getAttribute('title') || '';
            /* Two states, one place. A button that draws the action instead of
               spelling it swaps its glyph and says so through `title` and a
               live region; one that still carries a word swaps the word. Either
               way the button keeps the width it had, so a row of them cannot
               shuffle under the pointer that is still on one of them. */
            function done(ok) {
              btn.classList.add(ok ? 'ok' : 'fail');
              if (originalTitle) btn.setAttribute('title', ok ? 'Copied' : 'Press ⌘C to copy');
              if (label) {
                label.style.display = 'inline-block';
                label.style.minWidth = label.offsetWidth + 'px';
                label.textContent = ok ? 'copied ✓' : 'press ⌘C';
              } else {
                say(ok ? 'Copied' : 'Copy failed — press Command C');
              }
              setTimeout(function () {
                btn.classList.remove('ok', 'fail');
                if (originalTitle) btn.setAttribute('title', originalTitle);
                if (!label) return;
                label.textContent = original;
                label.style.minWidth = '';
                label.style.display = '';
              }, 1600);
            }
            /* Insecure origins and denied permissions both land here. Telling
               someone to press ⌘C without selecting anything is not a recovery,
               so fall back to a real copy, and if even that is refused, leave the
               value selected so the keystroke we suggest actually does something. */
            function fallback() {
              var scratch = document.createElement('textarea');
              scratch.value = value;
              scratch.setAttribute('readonly', '');
              scratch.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none;';
              document.body.appendChild(scratch);
              scratch.select();
              var copied = false;
              try { copied = document.execCommand('copy'); } catch (e) {}
              if (copied) {
                document.body.removeChild(scratch);
                done(true);
              } else {
                /* keep it on the page and selected until the user acts */
                setTimeout(function () {
                  if (scratch.parentNode) document.body.removeChild(scratch);
                }, 8000);
                done(false);
              }
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(value).then(function () { done(true); }, fallback);
            } else {
              fallback();
            }
          });
        });

        /* ---------- interactive terminal ---------- */
        var overlay = document.getElementById('termOverlay');
        var body = document.getElementById('termBody');
        var input = document.getElementById('termInput');
        var history = [];
        var historyIndex = -1;

        function termOpen() { return overlay && overlay.classList.contains('open'); }

        /* while the terminal is open the caret lives in the input — clicking the
           body, the chrome or the backdrop never leaves it without focus. */
        function focusInput() {
          if (!termOpen() || !input) return;
          var sel = window.getSelection && window.getSelection().toString();
          if (sel) return; /* mid text-selection: don't steal it */
          input.focus();
        }

        var termOpener = null;

        function openTerm() {
          if (termOpen()) return;
          termOpener = document.activeElement;
          overlay.classList.add('open');
          document.body.classList.add('term-open');
          setTimeout(focusInput, 40);
        }
        function closeTerm() {
          if (!termOpen()) return;
          overlay.classList.remove('open');
          document.body.classList.remove('term-open');
          if (input) input.blur();
          /* hand the caret back where it came from, not to the top of the page */
          if (termOpener && document.contains(termOpener) && termOpener.focus) termOpener.focus();
          termOpener = null;
        }

        /* The caret lives in the input, except when focus is moving to another
           control inside the dialog — the close button has to be reachable. */
        if (input) input.addEventListener('blur', function (e) {
          if (e.relatedTarget && overlay.contains(e.relatedTarget)) return;
          setTimeout(focusInput, 0);
        });
        if (overlay) overlay.addEventListener('mouseup', function () { setTimeout(focusInput, 0); });
        window.addEventListener('focus', focusInput);

        var termOpenBtn = document.getElementById('termOpen');
        if (termOpenBtn) termOpenBtn.addEventListener('click', openTerm);
        var termClose = document.getElementById('termClose');
        if (termClose) termClose.addEventListener('click', closeTerm);
        if (overlay) overlay.addEventListener('click', function (e) { if (e.target === overlay) closeTerm(); });

        function esc(str) {
          return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function print(html, cls) {
          var div = document.createElement('div');
          div.className = cls || 'out';
          div.innerHTML = html;
          body.appendChild(div);
          body.scrollTop = body.scrollHeight;
        }

        var SECTIONS = ['about', 'experience', 'projects', 'education', 'open-source', 'skills', 'contact', 'blog'];

        var commands = {
          help: function () {
            return 'available commands:\n' +
              '  <span class="k">about</span>        how I got here\n' +
              '  <span class="k">experience</span>   where I have worked\n' +
              '  <span class="k">projects</span>     things I have built\n' +
              '  <span class="k">oss</span>          public repositories\n' +
              '  <span class="k">skills</span>       what I reach for\n' +
              '  <span class="k">stack</span>        current stack\n' +
              '  <span class="k">contact</span>      get in touch\n' +
              '  <span class="k">resume</span>       download the PDF\n' +
              '  <span class="k">theme</span>        ' + (themeLocked ? 'show the pinned mode' : 'flip light / dark') + '\n' +
              '  <span class="k">goto</span> [sec]   scroll to a section\n' +
              '  <span class="k">neofetch</span>     system info\n' +
              '  <span class="k">clear</span>        clear the screen';
          },
          about: function () {
            return 'Founding software engineer @ Mando. Chemical Engineering, IIT Madras.\n' +
              'I own products end to end: API, interface, and everything between.\n' +
              'Previously two years on real-time trading systems at QB.';
          },
          experience: function () {
            return 'Mando                  founding software engineer   Sep 2024 → now\n' +
              'Quantitative Brokers   software engineer            Jul 2022 → Sep 2024\n' +
              'Quantitative Brokers   swe intern                   May 2021 → Jul 2021\n' +
              'Prescribe              android developer            Feb 2021 → May 2021\n' +
              'Workfence              swe intern                   May 2020 → Jul 2020\n' +
              '<span class="cmt"># goto experience for the detail</span>';
          },
          projects: function () {
            return 'leak       terminal subscription manager · Go · brew installable\n' +
              'deadfall   dead React component detector · npm\n' +
              'fanpark    IPL playoff race tracker · NRR + match impact\n' +
              'rubiks     Kociemba two-phase solver, webcam scan, 3D playback\n' +
              '<span class="cmt"># goto projects for the detail</span>';
          },
          oss: function () {
            return 'nimbus                 animated ASCII weather CLI · Go\n' +
              'youtube_music_lyrics   offline lyrics romanizer · Chrome extension\n' +
              'marvel_nexus           MCU story-dependency graph · Astro\n' +
              'lift_simulation        sky-lobby lift discrete-event sim · Python\n' +
              '<span class="cmt"># github.com/RishikeshSreekumar</span>';
          },
          skills: function () {
            /* Same seven groups the skills section uses; keep them in step. */
            return 'languages   TypeScript, Python, Go, SQL, Java\n' +
              'interfaces  React, Next.js, Astro, SvelteKit, Angular, Tailwind\n' +
              'services    FastAPI, Node.js, .NET, WebSockets, Stripe\n' +
              'ai          LLM apps, RAG, vector search, MCP\n' +
              'data        PostgreSQL, pgvector, Redis, SQLite\n' +
              'ship & run  Terraform, Docker, AWS, Azure, GitHub Actions\n' +
              'runtime     Chrome extensions, Web Audio, Web Workers, Playwright';
          },
          stack: function () {
            return '<span class="k">Next.js</span> · <span class="k">FastAPI</span> · <span class="k">PostgreSQL</span> · <span class="k">Go</span> · <span class="k">Terraform</span> · <span class="k">Stripe</span> · <span class="k">LLMs</span>';
          },
          contact: function () {
            return 'email     rishikeshpavithram@gmail.com\n' +
              'github    github.com/RishikeshSreekumar\n' +
              'linkedin  linkedin.com/in/rishikesh-s-0a4a47166\n' +
              'location  Chennai, India (IST, UTC+5:30)\n' +
              '<span class="cmt"># goto contact to send a message</span>';
          },
          resume: function () {
            var link = document.createElement('a');
            link.href = resumeUrl;
            link.download = '';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return 'downloading <span class="k">' + resumeUrl.split('/').pop() + '</span> … <span class="cmt"># single column, ATS-parseable</span>';
          },
          theme: function () {
            if (themeLocked) {
              return 'theme is pinned to <span class="k">' + document.documentElement.getAttribute('data-theme') + '</span> on this site';
            }
            toggleTheme();
            return 'theme → <span class="k">' + document.documentElement.getAttribute('data-theme') + '</span>';
          },
          neofetch: function () {
            return '<span class="k">rishikesh</span>@<span class="k">portfolio</span>\n' +
              '-------------------------\n' +
              'Role      Founding Software Engineer\n' +
              'Company   Mando\n' +
              'Uptime    4+ years shipping\n' +
              'Shell     zsh · nvim · tmux\n' +
              'Host      Chennai, India\n' +
              'Built by  Astro · 0 client frameworks';
          },
          whoami: function () { return 'rishikesh'; },
          ls: function () { return SECTIONS.map(function (s) { return s + '/'; }).join('  '); },
          sudo: function () { return '<span class="err">nice try.</span> <span class="cmt"># this incident has been reported</span>'; },
          clear: function () { body.innerHTML = ''; return null; }
        };

        var COMMAND_NAMES = Object.keys(commands).concat(['goto']);

        function run(raw) {
          var cmd = raw.trim();
          if (!cmd) return;
          history.push(cmd);
          historyIndex = history.length;
          print('<span class="ps1">rishikesh@portfolio:~$</span> ' + esc(cmd), 'pl-echo');

          var parts = cmd.split(/\s+/);
          var name = parts[0].toLowerCase();

          if (name === 'goto') {
            var target = (parts[1] || '').toLowerCase();
            /* the blog is its own site on a subdomain, not a section here */
            if (target === 'blog') {
              print('navigating to <span class="k">blog.rishikeshs.dev</span> …');
              setTimeout(function () {
                window.location.href = document.body.dataset.blog || '/blog/';
              }, 320);
              return;
            }
            if (SECTIONS.indexOf(target) >= 0) {
              print('navigating to <span class="k">~/' + target + '</span> …');
              setTimeout(function () {
                closeTerm();
                var section = document.getElementById(target);
                /* on a page without the sections — the blog — travel home */
                if (!section) { window.location.href = (document.body.dataset.home || '/') + '#' + target; return; }
                /* Scroll by hand and rewrite the current entry instead of
                   assigning location.hash, which pushes one. Three goto jumps
                   should not cost three presses of Back to leave the site.
                   scroll-padding-top is a CSS-only affordance, so the sticky nav
                   height is subtracted here. */
                var NAV = 80;
                var top = section.getBoundingClientRect().top + window.scrollY - NAV;
                window.scrollTo({ top: Math.max(top, 0), behavior: reduceMotion ? 'auto' : 'smooth' });
                /* `history` in this scope is the terminal's own command list, so
                   the browser's one has to be reached through window. */
                if (window.history && window.history.replaceState) {
                  window.history.replaceState(null, '', '#' + target);
                }
              }, 320);
            } else {
              print('goto: unknown section. try: ' + SECTIONS.join(', '));
            }
            return;
          }

          var fn = commands[name];
          if (fn) {
            var out = fn();
            if (out !== null) print(out.replace(/\n/g, '<br>'));
          } else {
            print('command not found: <span class="err">' + esc(name) + '</span>. type <span class="k">help</span>.');
          }
        }

        if (input) {
          input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
              run(input.value);
              input.value = '';
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              if (historyIndex > 0) { historyIndex--; input.value = history[historyIndex]; }
            } else if (e.key === 'ArrowDown') {
              e.preventDefault();
              if (historyIndex < history.length - 1) { historyIndex++; input.value = history[historyIndex]; }
              else { historyIndex = history.length; input.value = ''; }
            } else if (e.key === 'Tab') {
              /* Tab completes what you have typed; on an empty prompt, or with
                 Shift held, it stays a Tab so focus can still reach the close
                 button and leave the dialog. Completion is worth a key, not an
                 exit. */
              var typed = input.value.trim().toLowerCase();
              if (!typed || e.shiftKey) return;
              e.preventDefault();
              var matches = COMMAND_NAMES.filter(function (c) { return c.indexOf(typed) === 0; });
              if (matches.length === 1) input.value = matches[0] + ' ';
              else if (matches.length > 1) print(matches.join('  '), 'cmt');
            }
          });
        }

        /* ---------- global keyboard ---------- */
        document.addEventListener('keydown', function (e) {
          var active = document.activeElement;
          var typing = !!active && /^(INPUT|TEXTAREA)$/.test(active.tagName);
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            termOpen() ? closeTerm() : openTerm();
            return;
          }
          if (e.key === 'Escape') { closeTerm(); setDrawer(false); return; }
          if (typing || e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.key.toLowerCase() === 't' && !themeLocked) toggleTheme();
        });
      })();
    </script>
  </body>
</html>
