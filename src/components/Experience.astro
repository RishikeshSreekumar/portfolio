---
import { experience } from '../data/portfolio';
---

<section class="section" id="experience">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="ac">02</span> — experience</span>
      <h2 class="section-title">Work history</h2>
    </div>
    <div class="xp">
      {experience.map((exp) => {
        const present = /present|now/i.test(exp.period);
        return (
          <article class="xp-item reveal">
            <div class="xp-when">
              {present ? (
                <Fragment><span class="now">Present</span><span class="dur">{exp.period}</span></Fragment>
              ) : (
                exp.period
              )}
            </div>
            <div>
              <h3 class="xp-role">{exp.role}</h3>
              <div class="xp-co">{exp.company}</div>
              <p class="xp-summary">{exp.description}</p>
              <ul class="xp-list">
                {exp.highlights.map((h) => <li>{h}</li>)}
              </ul>
              <div class="tags">
                {exp.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
