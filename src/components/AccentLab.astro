---
/* Dev-only accent switcher.
 *
 * Layout renders this behind `import.meta.env.DEV`, so it is never in a build.
 * It writes `data-accent` and `data-theme` straight onto <html>, which means you
 * are auditioning the real site in the real palette — not a swatch of it. The
 * choice is kept in localStorage so it survives HMR reloads.
 *
 * When you settle on one, set `accent` (and `mode`) in src/data/theme.js, then
 * re-run `node scripts/generate-icons.mjs` and `npm run resume` so the committed
 * icons, share card and PDF follow the site. */
import { ACCENTS, theme } from '../data/theme.js';

const entries = Object.entries(ACCENTS);
---

<aside class="lab" id="accentLab" aria-label="Accent lab (development only)">
  <button class="lab-toggle" id="labToggle" type="button" title="Accent lab">
    <span class="lab-chip"></span>
  </button>

  <div class="lab-body" id="labBody" hidden>
    <div class="lab-head">
      <span>accent lab</span>
      <span class="lab-dev">dev only</span>
    </div>

    <div class="lab-grid">
      {
        entries.map(([name, a]) => (
          <button class="lab-swatch" type="button" data-accent-pick={name} title={a.label}>
            <span class="lab-pair">
              <span style={`background:${a.light.base}`}></span>
              <span style={`background:${a.dark.base}`}></span>
            </span>
            <span class="lab-name">{name}</span>
          </button>
        ))
      }
    </div>

    <div class="lab-head lab-head--sub"><span>mode</span></div>
    <div class="lab-modes">
      <button type="button" data-mode-pick="light">light</button>
      <button type="button" data-mode-pick="dark">dark</button>
      <button type="button" data-mode-pick="auto">auto</button>
    </div>

    <p class="lab-hint">
      Set it for real in <code>src/data/theme.js</code>:<br />
      <code id="labSnippet">accent: '{theme.accent}'</code>
    </p>
    <button class="lab-reset" id="labReset" type="button">reset to theme.js</button>
  </div>
</aside>

<style>
  .lab {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 200;
    font-family: var(--mono);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .lab-toggle {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--line-2);
    background: var(--panel);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 8px 24px -12px var(--shadow);
  }
  .lab-chip {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }

  .lab-body {
    width: 236px;
    padding: 12px;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 18px 40px -22px var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .lab-body[hidden] { display: none; }

  .lab-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .lab-head--sub { border-top: 1px solid var(--line); padding-top: 10px; }
  .lab-dev { color: var(--amber); }

  .lab-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .lab-swatch {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 6px 5px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--panel-2);
    cursor: pointer;
    transition: border-color .15s;
  }
  .lab-swatch:hover { border-color: var(--line-2); }
  .lab-swatch[aria-pressed="true"] { border-color: var(--accent); }
  .lab-pair { display: flex; height: 16px; border-radius: 3px; overflow: hidden; }
  .lab-pair span { flex: 1; }
  .lab-name { font-size: 9.5px; color: var(--ink-soft); text-align: center; }

  .lab-modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .lab-modes button {
    font-family: var(--mono);
    font-size: 10.5px;
    padding: 6px 0;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--panel-2);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .lab-modes button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent-2); }

  .lab-hint { margin: 0; font-size: 10px; line-height: 1.6; color: var(--ink-mute); }
  .lab-hint code {
    font-size: 10px;
    color: var(--accent-2);
    background: var(--accent-wash);
    padding: 1px 4px;
    border-radius: 3px;
  }
  .lab-reset {
    font-family: var(--mono);
    font-size: 10px;
    padding: 6px;
    border: 1px dashed var(--line-2);
    border-radius: 5px;
    background: none;
    color: var(--ink-mute);
    cursor: pointer;
  }
  .lab-reset:hover { color: var(--ink); }
</style>

<script is:inline define:vars={{ shipped: theme.accent, shippedMode: theme.mode }}>
  (function () {
    var root = document.documentElement;
    var body = document.getElementById('labBody');
    var snippet = document.getElementById('labSnippet');
    var KEY = 'accent-lab';

    function readStore() {
      try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { return {}; }
    }
    function writeStore(next) {
      try { localStorage.setItem(KEY, JSON.stringify(next)); } catch (e) {}
    }

    function applyMode(mode) {
      if (mode === 'auto') {
        root.removeAttribute('data-theme-lock');
        var system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.setAttribute('data-theme', system);
      } else {
        root.setAttribute('data-theme', mode);
        root.setAttribute('data-theme-lock', '');
      }
    }

    function paint(state) {
      var accent = state.accent || shipped;
      var mode = state.mode || shippedMode;
      root.setAttribute('data-accent', accent);
      applyMode(mode);
      snippet.textContent = "accent: '" + accent + "'" + (mode === 'auto' ? '' : ", mode: '" + mode + "'");
      document.querySelectorAll('[data-accent-pick]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.accentPick === accent));
      });
      document.querySelectorAll('[data-mode-pick]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.modePick === mode));
      });
    }

    var state = readStore();
    paint(state);

    document.getElementById('labToggle').addEventListener('click', function () {
      body.hidden = !body.hidden;
    });

    document.querySelectorAll('[data-accent-pick]').forEach(function (b) {
      b.addEventListener('click', function () {
        state.accent = b.dataset.accentPick;
        writeStore(state);
        paint(state);
      });
    });

    document.querySelectorAll('[data-mode-pick]').forEach(function (b) {
      b.addEventListener('click', function () {
        state.mode = b.dataset.modePick;
        writeStore(state);
        paint(state);
      });
    });

    document.getElementById('labReset').addEventListener('click', function () {
      state = {};
      writeStore(state);
      paint(state);
    });
  })();
</script>
