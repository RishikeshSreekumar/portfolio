---
import { personal } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumeUrl = `${base}/${personal.resumeFile}`;

const navLinks = [
  { href: '#about', label: '~/about' },
  { href: '#experience', label: '~/experience' },
  { href: '#projects', label: '~/projects' },
  { href: '#open-source', label: '~/open-source' },
  { href: '#skills', label: '~/skills' },
  { href: '#contact', label: '~/contact' },
];
---

<header class="nav" id="nav">
  <div class="nav-inner">
    <a href="#top" class="brand"><span class="sq"></span> rishikesh.s</a>

    <nav class="nav-links" id="navLinks">
      {navLinks.map((link) => <a href={link.href} data-nav={link.href.slice(1)}>{link.label}</a>)}
    </nav>

    <div class="nav-right">
      <button class="term-btn" id="termOpen" aria-label="Open terminal">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
        <span class="label">Terminal</span>
        <kbd>K</kbd>
      </button>

      <button class="icon-btn" id="themeBtn" aria-label="Toggle colour theme" title="Toggle theme (t)">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>

      <a class="nav-cta" href={resumeUrl} download>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 11l5 5 5-5M5 21h14"/></svg>
        resume.pdf
      </a>

      <button class="nav-menu-btn" id="menuBtn" aria-label="Menu" aria-expanded="false">≡</button>
    </div>
  </div>
  <div class="nav-progress" id="navProgress"></div>
</header>

<div class="drawer" id="drawer">
  <nav>
    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href={resumeUrl} download>~/resume.pdf ↓</a>
  </nav>
</div>
