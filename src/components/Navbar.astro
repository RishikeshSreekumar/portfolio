---
import { theme } from '../data/theme.js';
import Logo from './Logo.astro';

/* No toggle when the site is pinned to one mode — a control that cannot change
 * anything is worse than no control. */
const showThemeToggle = theme.mode === 'auto';

/* Plain words. The mono face already carries the register; the shell path in
 * front of every label was costume, and it was the first thing a non-technical
 * reader had to translate. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* The section links are hashes on the homepage so they scroll; from any other
 * route they have to travel home first. `onHome` also decides whether a link
 * carries `data-nav` — the scroll-spy only makes sense on the page that has
 * the sections. */
const path = Astro.url.pathname.replace(/\/$/, '');
const onHome = path === base || path === '';
const home = onHome ? '' : `${base}/`;

/* The blog is its own site on a subdomain, derived from `site` in the config
 * so one place still owns the domain. */
const blogUrl = Astro.site ? `${Astro.site.protocol}//blog.${Astro.site.host}/` : 'https://blog.rishikeshs.dev/';

const navLinks = [
  { href: `${home}#about`, id: 'about', label: 'About' },
  { href: `${home}#experience`, id: 'experience', label: 'Experience' },
  { href: `${home}#projects`, id: 'projects', label: 'Projects' },
  { href: `${home}#open-source`, id: 'open-source', label: 'Open source' },
  { href: `${home}#skills`, id: 'skills', label: 'Skills' },
  { href: blogUrl, id: null, label: 'Blog' },
  { href: `${home}#contact`, id: 'contact', label: 'Contact' },
];
---

<header class="nav" id="nav">
  <div class="nav-inner">
    <a href={onHome ? '#top' : `${base}/`} class="brand" aria-label="Rishikesh S — home"><Logo size={21} animate /> rishikesh.s</a>

    <nav class="nav-links" id="navLinks">
      {navLinks.map((link) => (
        <a href={link.href} data-nav={onHome && link.id ? link.id : undefined} class:list={{ active: link.active }}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav-right">
      <a class="nav-cta" href={`${home}#contact`}>Get in touch</a>

      <button class="term-btn" id="termOpen" aria-label="Open terminal" title="Open terminal (⌘K)">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
      </button>

      {showThemeToggle && (
        <button class="icon-btn" id="themeBtn" aria-label="Toggle colour theme" title="Toggle theme (t)">
          <svg aria-hidden="true" class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg aria-hidden="true" class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        </button>
      )}

      <button class="nav-menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">≡</button>
    </div>
  </div>
  <div class="nav-progress" id="navProgress"></div>
</header>

<div class="drawer" id="drawer">
  <nav>
    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</div>
