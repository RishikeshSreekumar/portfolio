---
const navLinks = [
  { href: '#about', label: '~/about' },
  { href: '#experience', label: '~/experience' },
  { href: '#education', label: '~/education' },
  { href: '#projects', label: '~/projects' },
  { href: '#skills', label: '~/skills' },
  { href: '#contact', label: '~/contact' },
];
---

<header class="nav" id="nav">
  <div class="nav-inner">
    <a href="#top" class="brand"><span class="sq"></span> rishikesh.s</a>
    <nav class="nav-links">
      {navLinks.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="nav-right">
      <button class="term-btn" id="termOpen"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17l6-5-6-5M12 19h8"/></svg> Terminal</button>
      <a href="#contact" class="nav-cta">schedule_call()</a>
      <button class="nav-menu-btn" id="menuBtn">≡</button>
    </div>
  </div>
</header>
