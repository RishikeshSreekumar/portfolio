---
import { personal } from '../data/portfolio';

const commands = [
  { cmd: 'about', label: 'about' },
  { cmd: 'education', label: 'education' },
  { cmd: 'experience', label: 'experience' },
  { cmd: 'projects', label: 'projects' },
  { cmd: 'skills', label: 'skills' },
  { cmd: 'contact', label: 'contact' },
];

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#education', label: 'Education' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<!-- ===== PROFESSIONAL NAVBAR ===== -->
<nav class="pro-nav pro-only">
  <div class="pro-nav-inner">
    <a href="#" class="pro-nav-brand">{personal.name}</a>

    <div class="pro-nav-links">
      {navLinks.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>

    <div class="pro-nav-actions">
      <button id="pro-theme-toggle" class="pro-btn-ghost" aria-label="Toggle theme">
        <span id="pro-theme-icon">☀</span>
      </button>
      <button class="pro-btn-ghost mode-toggle-btn" id="to-terminal-btn" aria-label="Switch to terminal mode">
        <span>&gt;_</span>
        <span>Terminal</span>
      </button>
      <a
        href={personal.social.cal}
        target="_blank"
        rel="noopener noreferrer"
        class="pro-btn-accent"
      >
        Schedule a call
      </a>
    </div>

    <!-- Mobile menu button -->
    <button class="pro-mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu dropdown -->
  <div id="mobile-menu" style="display:none; border-top: 1px solid var(--pro-border); background: var(--pro-surface);">
    <div style="max-width:1000px; margin:0 auto; padding:16px 24px; display:flex; flex-direction:column; gap:4px;">
      {navLinks.map(link => (
        <a href={link.href} class="pro-mobile-link" style="font-size:15px; font-weight:500; color:var(--pro-text-muted); text-decoration:none; padding:10px 8px; border-radius:6px;">
          {link.label}
        </a>
      ))}
      <div style="display:flex; gap:8px; margin-top:12px; padding-top:12px; border-top:1px solid var(--pro-border);">
        <button class="mode-toggle-btn pro-btn-ghost" style="flex:1; justify-content:center;">
          <span>&gt;_</span> Terminal
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- ===== TERMINAL NAVBAR ===== -->
<nav class="mb-8 terminal-only">
  <div class="mb-2 mt-6">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> help</span>
  </div>

  <div class="command-block">
    <div style="color: var(--terminal-comment); margin-bottom: 12px;">
      Available commands:
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-4">
      {commands.map((command) => (
        <a
          href={`#${command.cmd}`}
          class="flex items-center gap-2 px-3 py-2 hover:opacity-80 transition-opacity"
          style="background: var(--terminal-bg-secondary); border: 1px solid var(--terminal-border);"
        >
          <span style="color: var(--terminal-green);">→</span>
          <span style="color: var(--terminal-cyan);">./{command.label}</span>
        </a>
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-4 pt-2" style="border-top: 1px dashed var(--terminal-border);">
      <button
        id="theme-toggle"
        class="flex items-center gap-2 hover:opacity-80 transition-opacity"
        style="color: var(--terminal-yellow);"
      >
        <span>[</span>
        <span>theme: <span id="current-theme">dark</span></span>
        <span>]</span>
      </button>
      <button
        class="mode-toggle-btn flex items-center gap-2 hover:opacity-80 transition-opacity"
        style="color: var(--terminal-cyan);"
      >
        <span>[</span>
        <span>switch to: professional mode</span>
        <span>]</span>
      </button>
      <span style="color: var(--terminal-comment); font-size: 12px;">
        - Toggle light/dark or switch view
      </span>
    </div>
  </div>
</nav>

<script>
  // ---- Mode toggle (shared between both navbars) ----
  function applyMode(isPro: boolean) {
    document.documentElement.classList.toggle('professional-mode', isPro);
    localStorage.setItem('portfolioMode', isPro ? 'professional' : 'terminal');
  }

  document.querySelectorAll('.mode-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const isPro = document.documentElement.classList.contains('professional-mode');
      applyMode(!isPro);
    });
  });

  // ---- Professional theme toggle ----
  const proThemeToggle = document.getElementById('pro-theme-toggle');
  const proThemeIcon = document.getElementById('pro-theme-icon');

  function updateProThemeIcon() {
    const isDark = document.documentElement.classList.contains('dark');
    if (proThemeIcon) proThemeIcon.textContent = isDark ? '☀' : '☾';
  }
  updateProThemeIcon();

  proThemeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateProThemeIcon();
  });

  // ---- Terminal theme toggle ----
  const themeToggle = document.getElementById('theme-toggle');
  const currentTheme = document.getElementById('current-theme');

  function updateThemeLabel() {
    const isDark = document.documentElement.classList.contains('dark');
    if (currentTheme) currentTheme.textContent = isDark ? 'dark' : 'light';
  }
  updateThemeLabel();

  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeLabel();
    updateProThemeIcon();
  });

  // ---- Mobile menu toggle ----
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuBtn?.addEventListener('click', () => {
    if (mobileMenu) {
      mobileMenu.style.display = mobileMenu.style.display === 'none' ? 'block' : 'none';
    }
  });
  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (mobileMenu) mobileMenu.style.display = 'none';
    });
  });
</script>
