---
import { personal, asciiArt } from '../data/portfolio';

const welcomeMessages = [
  { delay: 0, text: 'Welcome to Ubuntu 24.04 LTS (GNU/Linux 6.8.0-generic x86_64)' },
  { delay: 1, text: '' },
  { delay: 2, text: ' * Documentation:  https://help.ubuntu.com' },
  { delay: 3, text: ' * Management:     https://landscape.canonical.com' },
  { delay: 4, text: ' * Support:        https://ubuntu.com/pro' },
  { delay: 5, text: '' },
];

const systemInfo = [
  { key: 'User', value: personal.name },
  { key: 'Role', value: personal.role },
  { key: 'Location', value: personal.location },
  { key: 'Status', value: personal.status },
  { key: 'Uptime', value: `${personal.experience} experience` },
];

const username = personal.name.toLowerCase().replace(' ', '');
---

<!-- ===== PROFESSIONAL HERO ===== -->
<section class="pro-hero pro-only">
  <div class="pro-hero-inner">
    <div class="pro-hero-status">
      <span class="pro-hero-status-dot"></span>
      {personal.status}
    </div>

    <h1 class="pro-hero-name">{personal.name}</h1>

    <p class="pro-hero-role">{personal.role}</p>

    <p class="pro-hero-bio">{personal.bio}</p>

    <div class="pro-hero-cta">
      <a href="#projects" class="pro-hero-cta-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        View my work
      </a>
      <a href="#contact" class="pro-hero-cta-secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Contact me
      </a>
      <a
        href={personal.social.cal}
        target="_blank"
        rel="noopener noreferrer"
        class="pro-hero-cta-secondary"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Schedule a call
      </a>
    </div>

    <div class="pro-hero-social">
      {personal.social.github && (
        <a href={personal.social.github} target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
      )}
      {personal.social.linkedin && (
        <a href={personal.social.linkedin} target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
      )}
    </div>
  </div>
</section>

<!-- ===== TERMINAL HERO ===== -->
<section class="mb-12 terminal-only">
  <div class="space-y-0">
    {welcomeMessages.map((msg) => (
      <div style="color: var(--terminal-text-dim); animation: fadeInLine 0.3s ease forwards; opacity: 0; animation-delay: {msg.delay * 0.1}s;">
        {msg.text}
      </div>
    ))}
  </div>

  <div class="mt-6 mb-2">
    <span class="terminal-prompt">last login:</span>
    <span style="color: var(--terminal-text);"> {new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })} on ttys000</span>
  </div>

  <div class="mt-6 mb-4">
    <span class="terminal-prompt">{username}@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> whoami</span>
  </div>

  <div style="color: var(--terminal-text-bright); font-weight: 500;">
    {personal.name} - {personal.role}
  </div>

  <div class="mt-6 mb-4">
    <span class="terminal-prompt">{username}@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> finger</span>
    <span style="color: var(--terminal-text-dim);"> {username}</span>
  </div>

  <div class="command-block">
    <div class="grid lg:grid-cols-2 gap-6">
      <div class="hidden lg:block">
        <pre style="color: var(--terminal-green); font-size: 11px; line-height: 1.2; overflow: hidden;">
{asciiArt.logo}
        </pre>
      </div>
      <div>
        {systemInfo.map((info, index) => (
          <div style="margin-bottom: 4px; animation: fadeInLine 0.3s ease forwards; opacity: 0; animation-delay: {0.6 + index * 0.1}s;">
            <span style="color: var(--terminal-cyan);">{info.key.padEnd(10)}</span>
            <span style="color: var(--terminal-text);">: {info.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="mt-6 mb-4">
    <span class="terminal-prompt">{username}@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> cat</span>
    <span style="color: var(--terminal-string);"> welcome.txt</span>
  </div>

  <div class="command-block">
    <p style="color: var(--terminal-text-bright);">
      Welcome to my interactive portfolio!
    </p>
    <p style="color: var(--terminal-text); margin-top: 12px;">
      {personal.bio}
    </p>
    <p style="color: var(--terminal-comment); margin-top: 12px;">
      # Use the commands above or scroll down to explore!
    </p>

    <div class="flex flex-wrap gap-3 mt-6 pt-4" style="border-top: 1px dashed var(--terminal-border);">
      <a
        href={personal.social.cal}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2 font-medium hover:opacity-85 transition-opacity"
        style="background: var(--terminal-cyan); color: var(--terminal-bg); border: 1px solid var(--terminal-cyan);"
      >
        <span>📅</span>
        <span>./schedule_call</span>
      </a>
      <a
        href="#contact"
        class="flex items-center gap-2 px-4 py-2 font-medium hover:opacity-85 transition-opacity"
        style="background: transparent; color: var(--terminal-green); border: 1px solid var(--terminal-green);"
      >
        <span>✉</span>
        <span>./get_in_touch</span>
      </a>
    </div>
  </div>
</section>
