---
import { personal } from '../data/portfolio';

/* The right-hand rail. Five brand marks and four facts — what the stack is,
   where the work is now, where it was, and what time zone it happens in. The
   marks come from simpleicons' CDN as flat single-colour SVGs, sized in the
   markup so the row never reflows once they land. */
const stack = [
  { name: 'Next.js', icon: 'nextdotjs/17160F' },
  { name: 'FastAPI', icon: 'fastapi/009688' },
  { name: 'PostgreSQL', icon: 'postgresql/4169E1' },
  { name: 'Go', icon: 'go/00ADD8' },
  { name: 'Terraform', icon: 'terraform/844FBA' },
];

const rail = [
  { k: 'now', v: 'Founding Engineer @ Mando' },
  { k: 'before', v: 'Quantitative Brokers · IIT Madras' },
  { k: 'based', v: `${personal.location} · IST` },
];
---

<section class="hero" id="hero">
  <div class="hero-inner">
    <div class="eyebrow reveal">{personal.role}</div>
    <h1 class="reveal">Rishikesh&nbsp;S<span class="dot">.</span></h1>

    <div class="hero-split">
      <div>
        <p class="hero-body reveal" set:html={personal.bio}></p>
        <div class="hero-actions reveal" style="--d:60ms">
          <a href="#projects" class="btn btn-primary">
            See what I've built
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v13M6 13l6 6 6-6"/></svg>
          </a>
          <a href={personal.social.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
            GitHub
          </a>
          <a href={personal.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.6h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9V9Z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>

      <div class="hero-rail reveal" style="--d:120ms">
        <div class="hero-stack">
          {stack.map((tech) => (
            <span>
              <img src={`https://cdn.simpleicons.org/${tech.icon}`} alt="" width="14" height="14" loading="lazy" decoding="async" />
              {tech.name}
            </span>
          ))}
        </div>
        {rail.map((row) => (
          <div class="row"><span class="k">{row.k}</span><span>{row.v}</span></div>
        ))}
        <div class="status"><span class="pulse"></span> Open to a good problem</div>
      </div>
    </div>
  </div>
</section>
