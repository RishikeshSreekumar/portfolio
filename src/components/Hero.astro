---
import { personal, stats } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumeUrl = `${base}/${personal.resumeFile}`;
---

<section class="hero">
  <div class="hero-inner">
    <div>
      <span class="badge"><span class="pulse"></span> {personal.status} · open to interesting problems</span>

      <h1><span class="scramble" data-scramble="Rishikesh S">Rishikesh&nbsp;S</span><span class="dot">.</span></h1>
      <p class="role">{personal.role}</p>

      <p class="hero-body" set:html={personal.bio}></p>

      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"/></svg>
          View my work
        </a>
        <a href={resumeUrl} download class="btn btn-dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 11l5 5 5-5M5 21h14"/></svg>
          Download resume
        </a>
        <button class="btn btn-ghost" id="termOpen2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
          Open terminal
        </button>
      </div>

      <div class="hero-social">
        <a href={personal.social.github} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
          GitHub
        </a>
        <a href={personal.social.linkedin} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.6h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9V9Z"/></svg>
          LinkedIn
        </a>
        <button data-copy={personal.email} class="copy-target">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16v12H4zM4 7l8 6 8-6"/></svg>
          <span class="txt">{personal.email}</span>
        </button>
      </div>
    </div>

    <div class="term reveal">
      <div class="term-bar">
        <span class="d r"></span><span class="d y"></span><span class="d g"></span>
        <span class="t">rishikesh@portfolio — zsh</span>
      </div>
      <div class="term-body" id="heroTerm"></div>
    </div>
  </div>
</section>

<div class="stat-strip">
  <div class="stat-inner">
    {stats.map((stat) => (
      <div class="stat reveal">
        <div class="v" data-count={stat.value} data-prefix={stat.prefix ?? ''} data-suffix={stat.suffix ?? ''}>
          {stat.prefix ?? ''}{stat.value}<span class="unit">{stat.suffix ?? ''}</span>
        </div>
        <div class="l">{stat.label}</div>
      </div>
    ))}
  </div>
</div>
