---
import { personal } from '../data/portfolio';

const side = [
  { k: 'role', v: 'Founding Engineer', ac: true },
  { k: 'company', v: 'Mando', ac: false },
  { k: 'education', v: 'IIT Madras', ac: false },
  { k: 'focus', v: 'AI · Full-stack', ac: false },
  { k: 'location', v: personal.location, ac: false },
  { k: 'status', v: 'open_to_talk', ac: true },
];
---

<section class="section" id="about">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="ac">01</span> — about</span>
      <h2 class="section-title">Who I am</h2>
    </div>
    <div class="about-grid">
      <div class="about-prose reveal">
        {personal.aboutParagraphs.map((para) => <p set:html={para} />)}
      </div>
      <aside class="about-side reveal">
        {side.map((row) => (
          <div class="row"><span class="k">{row.k}</span><span class={row.ac ? 'v ac' : 'v'}>{row.v}</span></div>
        ))}
      </aside>
    </div>
  </div>
</section>
