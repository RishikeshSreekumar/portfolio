---
import { openSource, personal } from '../data/portfolio';

const langColor: Record<string, string> = {
  Go: '#00ADD8',
  TypeScript: '#3178C6',
  Python: '#3572A5',
  Astro: '#FF5D01',
  SVG: '#FFB13B',
  Ruby: '#701516',
  JavaScript: '#F1E05A',
};
---

<section class="section" id="open-source">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="n">05</span> / Open source</span>
      <div class="head-row">
        <h2 class="section-title">Smaller things, all public</h2>
        <p class="desc">
          Weekend-sized problems that turned out to be more interesting than they looked.
        </p>
      </div>
    </div>

    {/* The whole card is the link. It gets a pointer and a lifted edge on hover;
        it does not also need an arrow flying in to announce that a link is a
        link. */}
    <div class="oss-grid">
      {openSource.map((item, i) => (
        <a class="oss reveal" href={item.liveUrl ?? item.url} target="_blank" rel="noopener noreferrer" style={`--d:${(i % 3) * 60}ms`}>
          <div class="head">
            <span class="nm">{item.name}</span>
            <span class="lang" style={`color:${langColor[item.lang] ?? 'var(--accent)'}`}><span class="dot"></span>{item.lang}</span>
          </div>
          <p>{item.description}</p>
          <div class="repo">
            <span class="path">RishikeshSreekumar/{item.repo}</span>
            {item.year && <span class="yr">{item.year}</span>}
            {item.liveUrl && <span class="live">live</span>}
          </div>
        </a>
      ))}
    </div>

    <div class="oss-more reveal">
      <a href={personal.social.github} target="_blank" rel="noopener noreferrer">The rest of it on GitHub →</a>
    </div>
  </div>
</section>
