---
import { openSource, personal } from '../data/portfolio';

const langColor: Record<string, string> = {
  Go: '#00ADD8',
  TypeScript: '#3178C6',
  Python: '#3572A5',
  Astro: '#FF5D01',
  Ruby: '#701516',
  JavaScript: '#F1E05A',
};
---

<section class="section" id="open-source">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="ac">05</span> — open source</span>
      <h2 class="section-title">The shelf</h2>
      <p class="desc">
        Smaller things, all public. Weekend-sized problems that were more interesting than they looked.
      </p>
    </div>

    <div class="oss-grid">
      {openSource.map((item, i) => (
        <a class="oss spot reveal" href={item.liveUrl ?? item.url} target="_blank" rel="noopener noreferrer" style={`--d:${(i % 3) * 60}ms`}>
          <div class="head">
            <span class="nm">
              {item.name}
              <svg class="arrow" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </span>
            <span class="lang"><span class="dot" style={`background:${langColor[item.lang] ?? 'var(--accent)'}`}></span>{item.lang}</span>
          </div>
          <p>{item.description}</p>
          <div class="repo">RishikeshSreekumar/{item.repo}</div>
        </a>
      ))}
    </div>

    <div class="oss-more reveal">
      <a class="btn btn-ghost" href={personal.social.github} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
        All 28 repositories on GitHub →
      </a>
    </div>
  </div>
</section>
