---
import { education } from '../data/portfolio';
---

<!-- ===== PROFESSIONAL EDUCATION ===== -->
<section id="education" class="pro-section pro-only">
  <div class="pro-container">
    <div class="pro-section-header">
      <p class="pro-section-label">Education</p>
      <h2 class="pro-section-title">Academic background</h2>
    </div>

    <div style="display:flex; flex-direction:column; gap:16px;">
      {education.map((edu) => (
        <div class="pro-edu-card">
          <div style="display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:8px;">
            <span class="pro-edu-institution">{edu.institution}</span>
            <span class="pro-edu-period">{edu.period}</span>
          </div>
          <span class="pro-edu-degree">{edu.degree}</span>
          <div class="pro-edu-highlights">
            {edu.highlights.map((h) => (
              <div class="pro-edu-highlight">
                <span style="color:var(--pro-accent-text); flex-shrink:0; margin-top:2px;">›</span>
                <span>{h}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== TERMINAL EDUCATION ===== -->
<section id="education" class="mb-12 terminal-only">
  <hr class="section-divider" />

  <div class="mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> cat education.md</span>
  </div>

  <div class="command-block">
    <div style="color: var(--terminal-yellow); margin-bottom: 12px;">
      ## Education
    </div>

    <div class="space-y-6">
      {education.map((edu) => (
        <div class="border-l-2 pl-4" style="border-color: var(--terminal-cyan);">
          <div class="flex flex-wrap items-baseline gap-2 mb-1">
            <span style="color: var(--terminal-cyan); font-weight: 700; font-size: 16px;">
              {edu.institution}
            </span>
            <span style="color: var(--terminal-text-dim); font-size: 13px;">
              — one of India's IITs
            </span>
          </div>

          <div class="flex flex-wrap items-baseline gap-3 mb-2">
            <span style="color: var(--terminal-green); font-weight: 500;">
              {edu.degree}
            </span>
            <span style="color: var(--terminal-comment); font-size: 13px;">
              {edu.period}
            </span>
          </div>

          <div class="ml-2 space-y-1 mt-3">
            {edu.highlights.map((highlight) => (
              <div class="flex gap-2" style="color: var(--terminal-text);">
                <span style="color: var(--terminal-green); flex-shrink: 0;">▸</span>
                <span>{highlight}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
