---
import { education } from '../data/portfolio';
---

<section class="section" id="education">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="ac">03</span> — education</span>
      <h2 class="section-title">Foundations</h2>
    </div>
    {education.map((edu) => (
      <div class="edu-card reveal">
        <div class="xp-when">{edu.period}<span class="dur">B.Tech</span></div>
        <div>
          <div class="edu-deg">{edu.degree.replace(/^B\.Tech,?\s*/i, '')}</div>
          <div class="edu-school">{edu.institution === 'IIT Madras' ? 'Indian Institute of Technology, Madras' : edu.institution}</div>
          <p class="edu-note">{edu.highlights[1] ?? edu.highlights[0]}</p>
        </div>
      </div>
    ))}
  </div>
</section>
