---
import { personal } from '../data/portfolio';

const FORMSPREE_ENDPOINT = "https://formspree.io/f/YOUR_FORM_ID";
---

<!-- ===== PROFESSIONAL CONTACT ===== -->
<section id="contact" class="pro-section pro-only">
  <div class="pro-container">
    <div class="pro-section-header">
      <p class="pro-section-label">Contact</p>
      <h2 class="pro-section-title">Let's work together</h2>
    </div>

    <div class="pro-contact-grid">
      <!-- Left: info + social -->
      <div>
        <p style="font-size:15px; line-height:1.7; color:var(--pro-text-muted); margin-bottom:32px;">
          I'm always open to interesting conversations and new opportunities. Whether you have a question, a project idea, or just want to say hi — feel free to reach out.
        </p>

        <div style="display:flex; flex-direction:column;">
          <div class="pro-contact-info-item">
            <span class="pro-contact-label">Email</span>
            <span class="pro-contact-value">
              <a href={`mailto:${personal.email}`}>{personal.email}</a>
            </span>
          </div>
          <div class="pro-contact-info-item">
            <span class="pro-contact-label">Location</span>
            <span class="pro-contact-value">{personal.location}</span>
          </div>
          <div class="pro-contact-info-item">
            <span class="pro-contact-label">Status</span>
            <span class="pro-contact-value" style="color:var(--pro-green);">{personal.status}</span>
          </div>
        </div>

        <div class="pro-contact-social">
          {personal.social.github && (
            <a href={personal.social.github} target="_blank" rel="noopener noreferrer" class="pro-contact-social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              GitHub
            </a>
          )}
          {personal.social.linkedin && (
            <a href={personal.social.linkedin} target="_blank" rel="noopener noreferrer" class="pro-contact-social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          )}
          {personal.social.cal && (
            <a href={personal.social.cal} target="_blank" rel="noopener noreferrer" class="pro-contact-social-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Schedule a call
            </a>
          )}
        </div>
      </div>

      <!-- Right: contact form -->
      <div>
        <form id="pro-contact-form" class="pro-form" data-endpoint={FORMSPREE_ENDPOINT}>
          <div class="pro-form-group">
            <label for="pro-contact-name" class="pro-form-label">Your name</label>
            <input
              type="text"
              id="pro-contact-name"
              name="name"
              required
              class="pro-form-input"
              placeholder="Jane Smith"
            />
          </div>
          <div class="pro-form-group">
            <label for="pro-contact-email" class="pro-form-label">Email address</label>
            <input
              type="email"
              id="pro-contact-email"
              name="email"
              required
              class="pro-form-input"
              placeholder="jane@company.com"
            />
          </div>
          <div class="pro-form-group">
            <label for="pro-contact-message" class="pro-form-label">Message</label>
            <textarea
              id="pro-contact-message"
              name="message"
              rows="5"
              required
              class="pro-form-input pro-form-textarea"
              placeholder="Tell me about your project or idea..."
            ></textarea>
          </div>

          <div id="pro-form-status" style="display:none; margin-bottom:16px;">
            <div id="pro-form-success" style="display:none; color:var(--pro-green); font-size:14px; font-weight:500;">
              Message sent! I'll get back to you soon.
            </div>
            <div id="pro-form-error" style="display:none; color:var(--pro-red); font-size:14px; font-weight:500;">
              Something went wrong. Please email me directly at {personal.email}
            </div>
          </div>

          <div style="display:flex; gap:12px;">
            <button type="submit" id="pro-submit-btn" class="pro-btn-accent" style="padding:10px 20px; font-size:15px;">
              Send message
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ===== TERMINAL CONTACT ===== -->
<section id="contact" class="mb-12 terminal-only">
  <hr class="section-divider" />

  <div class="mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> cat contact.txt</span>
  </div>

  <div class="command-block">
    <div style="color: var(--terminal-yellow); margin-bottom: 16px;">
      ═══════════════════════════════════════
             CONTACT INFORMATION
      ═══════════════════════════════════════
    </div>

    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <span style="color: var(--terminal-cyan);">📧  Email:</span>
        <a href={`mailto:${personal.email}`} style="color: var(--terminal-string);">{personal.email}</a>
      </div>
      <div class="flex items-center gap-3">
        <span style="color: var(--terminal-cyan);">📍  Location:</span>
        <span style="color: var(--terminal-text);">{personal.location}</span>
      </div>
      <div class="flex items-center gap-3">
        <span style="color: var(--terminal-cyan);">💼  Status:</span>
        <span style="color: var(--terminal-green);">{personal.status}</span>
      </div>
    </div>

    <div class="mt-6 pt-4" style="border-top: 1px dashed var(--terminal-border);">
      <div style="color: var(--terminal-comment); margin-bottom: 12px;">
        # Connect with me:
      </div>
      <div class="flex flex-wrap gap-4">
        {personal.social.github && (
          <a href={personal.social.github} style="color: var(--terminal-text);" class="hover:underline" target="_blank" rel="noopener noreferrer">
            [GitHub]
          </a>
        )}
        {personal.social.linkedin && (
          <a href={personal.social.linkedin} style="color: var(--terminal-text);" class="hover:underline" target="_blank" rel="noopener noreferrer">
            [LinkedIn]
          </a>
        )}
      </div>
    </div>
  </div>

  <div class="mt-6 mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> ./book_meeting</span>
    <span style="color: var(--terminal-string);"> --with rishikesh</span>
  </div>

  <div class="command-block" style="border-color: var(--terminal-cyan);">
    <div style="color: var(--terminal-text-bright); margin-bottom: 8px; font-weight: 500;">
      Prefer a live conversation?
    </div>
    <p style="color: var(--terminal-text); margin-bottom: 16px;">
      Book a 30-minute call directly on my calendar — no back-and-forth.
    </p>
    <a
      href={personal.social.cal}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 font-medium hover:opacity-85 transition-opacity"
      style="background: var(--terminal-cyan); color: var(--terminal-bg); border: 1px solid var(--terminal-cyan);"
    >
      <span>📅</span>
      <span>./schedule_on_cal.com</span>
    </a>
  </div>

  <div class="mt-6 mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> mail</span>
    <span style="color: var(--terminal-text-dim);"> -s</span>
    <span style="color: var(--terminal-string);"> "Let's talk"</span>
    <span style="color: var(--terminal-text-dim);"> {personal.email}</span>
  </div>

  <div class="command-block" style="border-color: var(--terminal-orange);">
    <div style="color: var(--terminal-orange); margin-bottom: 12px; font-weight: 500;">
      Or send a message directly:
    </div>

    <form id="contact-form" class="space-y-4" data-endpoint={FORMSPREE_ENDPOINT}>
      <div>
        <label style="color: var(--terminal-comment); display: block; margin-bottom: 4px;">
          To: {personal.email}
        </label>
      </div>
      <div>
        <label for="contact-name" style="color: var(--terminal-comment); display: block; margin-bottom: 4px;">From:</label>
        <input type="text" id="contact-name" name="name" required class="w-full px-3 py-2 outline-none"
          style="background: var(--terminal-bg); border: 1px solid var(--terminal-border); color: var(--terminal-text-bright);"
          placeholder="Your name" />
      </div>
      <div>
        <label for="contact-email" style="color: var(--terminal-comment); display: block; margin-bottom: 4px;">Reply-to:</label>
        <input type="email" id="contact-email" name="email" required class="w-full px-3 py-2 outline-none"
          style="background: var(--terminal-bg); border: 1px solid var(--terminal-border); color: var(--terminal-text-bright);"
          placeholder="your@email.com" />
      </div>
      <div>
        <label for="contact-message" style="color: var(--terminal-comment); display: block; margin-bottom: 4px;">Message body:</label>
        <textarea id="contact-message" name="message" rows="4" required class="w-full px-3 py-2 outline-none resize-none"
          style="background: var(--terminal-bg); border: 1px solid var(--terminal-border); color: var(--terminal-text-bright);"
          placeholder="Type your message here..."></textarea>
      </div>

      <div id="form-status" class="hidden">
        <div id="form-success" class="hidden" style="color: var(--terminal-green);">✓ Message sent! I'll get back to you soon.</div>
        <div id="form-error" class="hidden" style="color: var(--terminal-red);">✗ Something went wrong. Please email me directly at {personal.email}</div>
      </div>

      <div class="flex gap-3">
        <button type="submit" id="submit-btn" class="px-4 py-2 border hover:opacity-80 transition-opacity"
          style="background: var(--terminal-green); color: var(--terminal-bg); border-color: var(--terminal-green);">
          [Send Message]
        </button>
        <button type="button" class="px-4 py-2 border hover:opacity-80 transition-opacity"
          style="background: transparent; color: var(--terminal-red); border-color: var(--terminal-red);"
          onclick="document.getElementById('contact-form').reset(); document.getElementById('form-status').classList.add('hidden'); document.getElementById('form-success').classList.add('hidden'); document.getElementById('form-error').classList.add('hidden');">
          [Clear]
        </button>
      </div>
    </form>
  </div>

  <div class="mt-6 mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-comment"> # Looking forward to hearing from you!</span>
  </div>
</section>

<script>
  // ---- Terminal contact form ----
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const formStatus = document.getElementById('form-status');
  const formSuccess = document.getElementById('form-success');
  const formError = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;
    const endpoint = form.dataset.endpoint ?? '';
    submitBtn.textContent = '[Sending...]';
    submitBtn.disabled = true;
    try {
      const data = new FormData(form);
      const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      formStatus?.classList.remove('hidden');
      if (response.ok) {
        formSuccess?.classList.remove('hidden');
        formError?.classList.add('hidden');
        form.reset();
        submitBtn.textContent = '[Sent ✓]';
      } else { throw new Error('failed'); }
    } catch {
      formStatus?.classList.remove('hidden');
      formError?.classList.remove('hidden');
      formSuccess?.classList.add('hidden');
      submitBtn.textContent = '[Send Message]';
      submitBtn.disabled = false;
    }
  });

  // ---- Professional contact form ----
  const proForm = document.getElementById('pro-contact-form') as HTMLFormElement | null;
  const proSubmitBtn = document.getElementById('pro-submit-btn') as HTMLButtonElement | null;
  const proFormStatus = document.getElementById('pro-form-status');
  const proFormSuccess = document.getElementById('pro-form-success');
  const proFormError = document.getElementById('pro-form-error');

  proForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!proSubmitBtn) return;
    const endpoint = proForm.dataset.endpoint ?? '';
    proSubmitBtn.textContent = 'Sending...';
    proSubmitBtn.disabled = true;
    try {
      const data = new FormData(proForm);
      const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (proFormStatus) proFormStatus.style.display = 'block';
      if (response.ok) {
        if (proFormSuccess) proFormSuccess.style.display = 'block';
        if (proFormError) proFormError.style.display = 'none';
        proForm.reset();
        proSubmitBtn.textContent = 'Sent ✓';
      } else { throw new Error('failed'); }
    } catch {
      if (proFormStatus) proFormStatus.style.display = 'block';
      if (proFormError) proFormError.style.display = 'block';
      if (proFormSuccess) proFormSuccess.style.display = 'none';
      proSubmitBtn.textContent = 'Send message';
      proSubmitBtn.disabled = false;
    }
  });
</script>
