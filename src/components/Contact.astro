---
import { personal } from '../data/portfolio';

const FORMSPREE_ENDPOINT = "https://formspree.io/f/YOUR_FORM_ID";
---

<section class="section" id="contact">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="ac">06</span> — contact</span>
      <h2 class="section-title">Let's work together</h2>
    </div>
    <div class="contact-grid">
      <div class="contact-info reveal">
        <p class="desc">I'm always open to interesting conversations and new opportunities. Whether you have a question, a project idea, or just want to say hi — feel free to reach out.</p>
        <div class="info-row"><span class="k">email</span><span class="v ac"><a href={`mailto:${personal.email}`}>{personal.email}</a></span></div>
        <div class="info-row"><span class="k">location</span><span class="v">{personal.location}</span></div>
        <div class="info-row"><span class="k">status</span><span class="v status"><span class="pulse"></span> {personal.status}</span></div>
        <div class="contact-socials">
          {personal.social.github && (
            <a href={personal.social.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>GitHub</a>
          )}
          {personal.social.linkedin && (
            <a href={personal.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.6h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9V9Z"/></svg>LinkedIn</a>
          )}
          {personal.social.cal && (
            <a href={personal.social.cal} target="_blank" rel="noopener noreferrer" class="btn btn-ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>Schedule a call</a>
          )}
        </div>
      </div>
      <div class="form-panel reveal">
        <form class="contact-form" id="contact-form" data-endpoint={FORMSPREE_ENDPOINT}>
          <div class="field"><label for="n">Your name</label><input id="n" name="name" type="text" required placeholder="Jane Smith" /></div>
          <div class="field"><label for="e">Email address</label><input id="e" name="email" type="email" required placeholder="jane@company.com" /></div>
          <div class="field"><label for="m">Message</label><textarea id="m" name="message" rows="5" required placeholder="Tell me about your project or idea..."></textarea></div>
          <div id="form-status" style="display:none; font-family:var(--mono); font-size:13px;">
            <span id="form-success" style="display:none; color:var(--accent-2);">✓ Message sent! I'll get back to you soon.</span>
            <span id="form-error" style="display:none; color:#C0392B;">✗ Something went wrong. Email me directly at {personal.email}</span>
          </div>
          <button type="submit" id="submit-btn" class="btn btn-primary">Send message →</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const formStatus = document.getElementById('form-status');
  const formSuccess = document.getElementById('form-success');
  const formError = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;
    const endpoint = form.dataset.endpoint ?? '';
    submitBtn.textContent = 'Sending…';
    submitBtn.disabled = true;
    try {
      const data = new FormData(form);
      const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (formStatus) formStatus.style.display = 'block';
      if (response.ok) {
        if (formSuccess) formSuccess.style.display = 'inline';
        if (formError) formError.style.display = 'none';
        form.reset();
        submitBtn.textContent = 'Sent ✓';
      } else { throw new Error('failed'); }
    } catch {
      if (formStatus) formStatus.style.display = 'block';
      if (formError) formError.style.display = 'inline';
      if (formSuccess) formSuccess.style.display = 'none';
      submitBtn.textContent = 'Send message →';
      submitBtn.disabled = false;
    }
  });
</script>
