---
import { projects } from '../data/portfolio';
import Pill from './Pill.astro';

const featured = projects.filter((p) => p.featured);

function splitTitle(title: string) {
  const parts = title.split(/\s+—\s+/);
  return { main: parts[0], sub: parts.slice(1).join(' — ') };
}

/**
 * Two columns of cards, no pictures.
 *
 * A screenshot of a page you can open in the next click is a worse copy of the
 * thing itself, and six of them stacked down a section compete with each other
 * rather than with nothing. What replaces the frame is `facts`: the three or
 * four decisions that make each project the shape it is, in its own units. They
 * are the part a reader cannot get by clicking through.
 *
 * The project's own colour survives as the dot in front of its year — enough to
 * tell six cards apart, not enough to fight the site accent, which stays
 * swappable across all ten palettes.
 */
---

<section class="section" id="projects">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="n">03</span> / Projects</span>
      <div class="head-row">
        <h2 class="section-title">Things I’ve built</h2>
        <p class="desc">
          Mostly tools I wanted to exist and couldn’t find. Two of them you can install right now, in one command.
        </p>
      </div>
    </div>

    <div class="proj-grid">
      {featured.map((project, i) => {
        const { main, sub } = splitTitle(project.title);
        const when = [project.year, project.status].filter(Boolean).join(' · ');

        return (
          <article class="proj reveal" style={`--proj:${project.accent ?? 'var(--accent)'};--d:${(i % 2) * 70}ms`}>
            <div class="proj-head">
              <h3 class="proj-name">
                {project.liveUrl
                  ? <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">{main}</a>
                  : main}
                {sub && <span class="sub">— {sub}</span>}
              </h3>
              {when && <span class="proj-when">{when}</span>}
            </div>

            {project.tagline && <p class="proj-tagline">{project.tagline}</p>}
            <p class="proj-desc">{project.description}</p>

            {project.highlight && (
              <div class="proj-hl">
                <span class="k">The interesting part</span>
                <p>{project.highlight}</p>
              </div>
            )}

            {project.facts && (
              <ul class="proj-facts">
                {project.facts.map((fact) => <li>{fact}</li>)}
              </ul>
            )}

            {project.install && (
              <div class="proj-install">
                <span class="sig">$</span>
                <code>{project.install}</code>
                {/* The action is obvious enough to draw rather than spell. The
                    label lives in the title and the accessible name; the tick
                    is the confirmation, replacing the word `copy` in place so
                    the row cannot change width under the pointer. */}
                <button
                  class="icon-btn copy-target"
                  data-copy={project.install}
                  type="button"
                  title={`Copy: ${project.install}`}
                  aria-label={`Copy install command: ${project.install}`}
                >
                  <svg class="i-copy" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"/></svg>
                  <svg class="i-ok" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9.5 18 20 6.5"/></svg>
                </button>
              </div>
            )}

            <div class="tags">
              {project.tags.map((tag) => <Pill label={tag} />)}
            </div>

            <div class="proj-links">
              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">
                  {project.liveLabel ?? project.domain ?? 'Live demo'} ↗
                </a>
              )}
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>
              )}
              {!project.liveUrl && !project.githubUrl && (
                <span class="muted">private repo — happy to walk through it</span>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
