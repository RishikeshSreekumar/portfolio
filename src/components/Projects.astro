---
import { projects } from '../data/portfolio';

const featuredProjects = projects.filter(p => p.featured);
---

<!-- ===== PROFESSIONAL PROJECTS ===== -->
<section id="projects" class="pro-section pro-only">
  <div class="pro-container">
    <div class="pro-section-header">
      <p class="pro-section-label">Projects</p>
      <h2 class="pro-section-title">Things I've built</h2>
    </div>

    <div class="pro-projects-grid">
      {featuredProjects.map((project) => (
        <div class="pro-project-card">
          <div>
            <h3 class="pro-project-title">{project.title}</h3>
          </div>
          <p class="pro-project-desc">{project.description}</p>
          {project.highlight && (
            <p class="pro-project-highlight">
              <span class="pro-project-highlight-label">Key highlight</span>
              {project.highlight}
            </p>
          )}
          <div class="pro-project-tags">
            {project.tags.map((tag) => (
              <span class="pro-tag">{tag}</span>
            ))}
          </div>
          {(project.liveUrl || project.githubUrl) && (
            <div class="pro-project-links">
              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="pro-project-link">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Live demo
                </a>
              )}
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="pro-project-link">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                  Source code
                </a>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== TERMINAL PROJECTS ===== -->
<section id="projects" class="mb-12 terminal-only">
  <hr class="section-divider" />

  <div class="mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> cd projects/</span>
  </div>

  <div class="mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~/projects</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> ls -la</span>
  </div>

  <div class="command-block">
    <div style="color: var(--terminal-text-dim); margin-bottom: 8px;">
      total {featuredProjects.length}
    </div>
    <div style="color: var(--terminal-text-dim); margin-bottom: 8px;">
      drwxr-xr-x  {featuredProjects.length} items
    </div>

    <div class="mt-4 space-y-6">
      {featuredProjects.map((project) => (
        <div class="border-l-2 pl-4" style="border-color: var(--terminal-cyan);">
          <div class="flex items-center gap-2 mb-2">
            <span style="color: var(--terminal-yellow);">drwxr-xr-x</span>
            <span style="color: var(--terminal-cyan); font-weight: 600;">{project.title}/</span>
          </div>

          <div class="ml-4" style="color: var(--terminal-text);">
            <div style="color: var(--terminal-comment);">└── README.md</div>
            <div class="mt-2 mb-3" style="color: var(--terminal-text);">
              {project.description}
            </div>

            {project.highlight && (
              <div class="mb-3 flex gap-2" style="color: var(--terminal-text);">
                <span style="color: var(--terminal-green); flex-shrink: 0;">★</span>
                <span style="color: var(--terminal-text-bright);">{project.highlight}</span>
              </div>
            )}

            <div class="flex flex-wrap gap-2 mb-3">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <div class="flex gap-4">
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  class="flex items-center gap-1 hover:underline"
                  style="color: var(--terminal-green);"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>→</span>
                  <span>live_demo</span>
                </a>
              )}
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  class="flex items-center gap-1 hover:underline"
                  style="color: var(--terminal-orange);"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>→</span>
                  <span>source_code</span>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-6 mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~/projects</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-comment"> # These are some of my featured projects!</span>
  </div>
</section>
