---
import { skills, type Skill } from '../data/portfolio';

const categories = [...new Set(skills.map(skill => skill.category))];
---

<!-- ===== PROFESSIONAL SKILLS ===== -->
<section id="skills" class="pro-section pro-only">
  <div class="pro-container">
    <div class="pro-section-header">
      <p class="pro-section-label">Skills</p>
      <h2 class="pro-section-title">Technologies I work with</h2>
    </div>

    <div class="pro-skills-grid">
      {categories.map((category) => (
        <div class="pro-skill-category">
          <div class="pro-skill-category-title">{category}</div>
          <div class="pro-skill-tags">
            {skills.filter(s => s.category === category).map((skill) => (
              <span class="pro-skill-tag">{skill.name}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== TERMINAL SKILLS ===== -->
<section id="skills" class="mb-12 terminal-only">
  <hr class="section-divider" />

  <div class="mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-command"> ./skills --list</span>
  </div>

  <div class="command-block">
    <div class="mb-6 border border-[var(--terminal-cyan)] p-3 text-center" style="color: var(--terminal-cyan);">
      INSTALLED PACKAGES
    </div>

    {categories.map((category) => (
      <div class="mb-6">
        <div style="color: var(--terminal-yellow); margin-bottom: 8px;">
          [{category}]
        </div>

        <div class="ml-4 flex flex-wrap gap-2">
          {skills.filter(skill => skill.category === category).map((skill) => (
            <span class="tag">{skill.name}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-6 mb-4">
    <span class="terminal-prompt">visitor@portfolio</span>
    <span style="color: var(--terminal-text-dim);">:</span>
    <span style="color: var(--terminal-blue);">~</span>
    <span style="color: var(--terminal-text-dim);">$</span>
    <span class="terminal-comment"> # Always learning new technologies!</span>
  </div>
</section>
