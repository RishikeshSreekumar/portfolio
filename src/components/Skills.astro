---
import { skills } from '../data/portfolio';

const categories = [...new Set(skills.map((s) => s.category))];
---

<section class="section" id="skills">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="ac">05</span> — skills</span>
      <h2 class="section-title">Technologies I work with</h2>
    </div>
    <div class="skills-grid reveal">
      {categories.map((category) => (
        <div class="skill-group">
          <div class="gname">{category}</div>
          <div class="skill-chips">
            {skills.filter((s) => s.category === category).map((s) => (
              s.url ? (
                <a class="chip chip-link" href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.name}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              ) : (
                <span class="chip">{s.name}</span>
              )
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
