---
import { skills, skillGroups } from '../data/portfolio';
import Pill from './Pill.astro';

/**
 * Grouped by the job the thing does, not by what kind of thing it is.
 * "Frontend / Backend / Tools" is a taxonomy of technologies; these are the
 * seven places work actually lands. Each group carries one line saying how it
 * gets used here, which is the part a list of names cannot say.
 */
const groups = skillGroups.filter((g) => skills.some((s) => s.category === g.name));
---

<section class="section" id="skills">
  <div class="section-inner">
    <div class="section-head reveal">
      <span class="mlabel"><span class="n">06</span> / Skills</span>
      <div class="head-row">
        <h2 class="section-title">What I reach for</h2>
        <p class="desc">No proficiency bars — nobody believes them anyway. If it’s here, I’ve shipped something with it and can talk through the parts that went wrong.</p>
      </div>
    </div>

    {groups.map((group, i) => (
      <div class="skill-row reveal" style={`--d:${Math.min(i, 3) * 50}ms`}>
        <div class="gname">{group.name}</div>
        <p class="gnote">{group.note}</p>
        <div class="skill-chips">
          {skills.filter((s) => s.category === group.name).map((s) => (
            <Pill label={s.name} href={s.url} />
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
